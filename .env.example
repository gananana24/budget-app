# Clerk browser-side publishable key (safe to expose to the browser)
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk server-side secret key (keep this secret)
CLERK_SECRET_KEY=

# Neon PostgreSQL connection string (keep this secret)
DATABASE_URL=

# Direct Neon PostgreSQL connection string for migrations (keep this secret)
DATABASE_URL_UNPOOLED=
