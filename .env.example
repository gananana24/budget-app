# Clerk browser-side publishable key (safe to expose to the browser)
VITE_CLERK_PUBLISHABLE_KEY=

# Local Hyperdrive connection used by the Cloudflare Vite plugin
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DATABASE=postgresql://postgres:postgres@127.0.0.1:54322/budget_app_dev?sslmode=disable

# Dedicated database used only by automated integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/budget_app_test?sslmode=disable
